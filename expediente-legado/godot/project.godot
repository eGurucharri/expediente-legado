; Proyecto Godot de SIGA-98 · Expediente Legado.
; Durante la migración convive con la app Spring de backend/: esta carpeta no
; depende de ella, y el contenido llega por datos/casos.json.

config_version=5

[application]

config/name="SIGA-98 · Expediente Legado"
run/main_scene="res://escenas/visor.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[rendering]

renderer/rendering_method="gl_compatibility"

[display]

window/size/viewport_width=1024
window/size/viewport_height=680
